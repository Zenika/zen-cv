# Copy to .env.local (ignored by git) and fill in.

# Dev database used by `pnpm dev`, `pnpm start`, `pnpm db:migrate` and `pnpm db:seed`.
# Through the Cloud SQL Auth Proxy: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Optional: enables the Postgres tests. They run in a temporary schema, dropped afterwards.
TEST_DATABASE_URL=
