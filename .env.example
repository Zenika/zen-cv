# Copy to .env.local (ignored by git) and fill in.

# Dev database used by `pnpm dev`, `pnpm start`, `pnpm db:migrate` and `pnpm db:seed`.
# Through the Cloud SQL Auth Proxy: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Test database, never the dev one. Optional for `pnpm test:unit`: enables the Postgres tests,
# which run in a temporary schema dropped afterwards. Required for `pnpm test:e2e`, which resets
# and uses the `e2e` schema. A local container works: postgresql://postgres:test@localhost:5499/postgres
TEST_DATABASE_URL=
